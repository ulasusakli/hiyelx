{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@hiyelx/project-engine": ["packages/project-engine/src/index.ts"],
      "@hiyelx/manifest-engine": ["packages/manifest-engine/src/index.ts"],
      "@hiyelx/graph-engine": ["packages/graph-engine/src/index.ts"],
      "@hiyelx/config-engine": ["packages/config-engine/src/index.ts"],
      "@hiyelx/telemetry": ["packages/telemetry/src/index.ts"],
      "@hiyelx/code-editor": ["packages/code-editor/src/index.ts"],
      "@hiyelx/ui": ["packages/ui/src/index.ts"]
    }
  },
  "include": [
    "apps/desktop/src/**/*.ts",
    "apps/desktop/src/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "features/**/*.ts",
    "features/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
